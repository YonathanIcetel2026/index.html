<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Inventario Clima - DCSM</title>
    <!-- Tailwind CSS para diseño rápido y moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js para el Dashboard -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Cliente de Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">

    <nav class="bg-slate-900 p-4 shadow-lg">
        <div class="container mx-auto flex justify-between items-center text-white">
            <h1 class="text-xl font-bold">Gestión de Stock Clima - DCSM</h1>
            <span class="text-sm font-semibold text-blue-300">Supervisor: Yonathan Solorzano</span>
        </div>
    </nav>

    <div class="container mx-auto mt-6 flex flex-wrap">
        <!-- Panel Lateral (Menú) -->
        <div class="w-full md:w-1/4 p-4">
            <div class="bg-white rounded-lg shadow p-4 mb-6">
                <h2 class="font-bold text-lg mb-4 text-gray-800 border-b pb-2">Navegación</h2>
                <ul class="flex flex-col space-y-2">
                    <li><button onclick="showTab('dashboard')" class="text-left w-full font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50 p-2 rounded transition">📊 Dashboard Visual</button></li>
                    <li><button onclick="showTab('movimientos')" class="text-left w-full font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50 p-2 rounded transition">🔄 Registrar IN / OUT</button></li>
                    <li><button onclick="showTab('catalogo')" class="text-left w-full font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50 p-2 rounded transition">➕ Añadir al Catálogo</button></li>
                </ul>
            </div>
        </div>

        <!-- Contenedor Principal -->
        <div class="w-full md:w-3/4 p-4" id="main-content">
            
            <!-- Pestaña 1: Dashboard -->
            <div id="tab-dashboard" class="tab-section">
                <h2 class="text-2xl font-bold mb-4 text-gray-800">Resumen de Inventario Crítico</h2>
                
                <!-- Tarjetas de KPIs -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-blue-500">
                        <h3 class="text-gray-500 text-sm font-bold uppercase tracking-wider">Gases Refrigerantes</h3>
                        <p class="text-3xl font-black text-slate-800 mt-2" id="kpi-refrigerante">-- <span class="text-sm font-normal text-gray-500">Kg</span></p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-green-500">
                        <h3 class="text-gray-500 text-sm font-bold uppercase tracking-wider">Motores Ventiladores</h3>
                        <p class="text-3xl font-black text-slate-800 mt-2" id="kpi-motores">-- <span class="text-sm font-normal text-gray-500">Unidades</span></p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-orange-500">
                        <h3 class="text-gray-500 text-sm font-bold uppercase tracking-wider">Correas</h3>
                        <p class="text-3xl font-black text-slate-800 mt-2" id="kpi-correas">-- <span class="text-sm font-normal text-gray-500">Unidades</span></p>
                    </div>
                </div>

                <!-- Gráfico Chart.js -->
                <div class="bg-white p-6 rounded-lg shadow">
                    <h3 class="font-bold text-gray-700 mb-4">Niveles de Stock por Ítem (Top 5)</h3>
                    <canvas id="stockChart" width="400" height="150"></canvas>
                </div>
            </div>

            <!-- Pestaña 2: Registro de Movimientos -->
            <div id="tab-movimientos" class="tab-section hidden">
                <div class="bg-white p-6 rounded-lg shadow border-t-4 border-slate-900">
                    <h2 class="text-2xl font-bold mb-6 text-gray-800">Registrar Consumo o Ingreso</h2>
                    <form id="form-movimiento" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Tipo de Movimiento</label>
                                <select id="mov-tipo" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm focus:ring-blue-500 focus:border-blue-500">
                                    <option value="IN">IN (Ingreso a Bodega)</option>
                                    <option value="OUT">OUT (Consumo en Terreno)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Consumible</label>
                                <select id="mov-item" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm">
                                    <!-- Las opciones se cargan desde Supabase -->
                                    <option value="1">Cargando catálogo...</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Cantidad (Unidades o Kg)</label>
                                <input type="number" step="0.1" id="mov-cantidad" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" required>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Fecha</label>
                                <input type="date" id="mov-fecha" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" required>
                            </div>
                            <div class="col-span-1 md:col-span-2 border-t pt-4 mt-2">
                                <h4 class="text-sm font-bold text-slate-500 uppercase mb-3">Detalles Técnicos (Requerido para OUT)</h4>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">TAG Equipo</label>
                                <input type="text" id="mov-tag" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" placeholder="Ej: ACU-221, Chiller 1">
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">SALA / Ubicación</label>
                                <input type="text" id="mov-sala" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" placeholder="Ej: Sala de Datos, Energía -1">
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Circuito (Cto)</label>
                                <input type="text" id="mov-cto" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" placeholder="Ej: Cto 1 o 2">
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700">Actividad / Observación</label>
                                <input type="text" id="mov-obs" class="mt-1 p-2 w-full border border-gray-300 rounded shadow-sm" placeholder="Ej: Recarga por fuga, Preventivo">
                            </div>
                        </div>
                        <div class="mt-6">
                            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded shadow hover:bg-blue-700 transition">Guardar Movimiento</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Pestaña 3: Nuevo Catálogo -->
            <div id="tab-catalogo" class="tab-section hidden">
                <div class="bg-white p-6 rounded-lg shadow border-t-4 border-green-600">
                    <h2 class="text-2xl font-bold mb-4 text-gray-800">Dar de Alta Nuevo Repuesto</h2>
                    <p class="text-sm text-gray-500 mb-6">Utiliza este formulario para ingresar una nueva medida de correa, un nuevo tipo de gas o modelo de ventilador que no exista en el sistema.</p>
                    
                    <form id="form-catalogo" class="space-y-4 max-w-lg">
                        <div>
                            <label class="block text-sm font-bold text-gray-700">Categoría Principal</label>
                            <select id="cat-categoria" class="mt-1 p-2 w-full border rounded shadow-sm">
                                <option value="Refrigerante">Gas Refrigerante</option>
                                <option value="Motores">Motores Ventiladores</option>
                                <option value="Correas">Correas</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700">Descripción Técnica (Marca/Modelo)</label>
                            <input type="text" id="cat-desc" class="mt-1 p-2 w-full border rounded shadow-sm" placeholder="Ej: R410a, 220V/500mm, AP36..." required>
                        </div>
                        <button type="submit" class="bg-green-600 text-white font-bold py-2 px-6 rounded shadow hover:bg-green-700 transition">Registrar en Catálogo</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <script>
        // --- 1. CONFIGURACIÓN SUPABASE ---
        // INSERTA TUS CREDENCIALES AQUÍ
        const SUPABASE_URL = 'https://qedseclajeysglueveia.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_kk_uPwH9L6Xl0227Fxu8KA_Kg-jiF0v';
        
        // Inicialización condicionada para evitar errores en vista previa sin credenciales
        let supabaseClient = null;
        if(SUPABASE_URL !== 'TU_SUPABASE_URL') {
            supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        }

        // --- 2. CONTROL DE PESTAÑAS ---
        function showTab(tabName) {
            document.querySelectorAll('.tab-section').forEach(tab => tab.classList.add('hidden'));
            document.getElementById('tab-' + tabName).classList.remove('hidden');
            if(tabName === 'dashboard') loadDashboard();
        }

        // --- 3. LÓGICA DE CARGA DE ITEMS ---
        async function loadItems() {
            const select = document.getElementById('mov-item');
            
            if (supabaseClient) {
                const { data, error } = await supabaseClient.from('inventario_items').select('*');
                if (!error && data) {
                    select.innerHTML = data.map(item => `<option value="${item.id}">${item.categoria} - ${item.descripcion}</option>`).join('');
                }
            } else {
                // Datos provisionales para visualizar la plantilla
                select.innerHTML = `
                    <option value="1">Refrigerante - R410a</option>
                    <option value="2">Motores - 220V/500mm</option>
                    <option value="3">Correas - A46</option>
                `;
            }
            
            // Setear la fecha de hoy por defecto en el formulario
            document.getElementById('mov-fecha').valueAsDate = new Date();
        }

        // --- 4. RENDERIZAR DASHBOARD Y KPIs ---
        let stockChartInst = null;
        async function loadDashboard() {
            // Lógica para el gráfico
            const ctx = document.getElementById('stockChart').getContext('2d');
            if(stockChartInst) stockChartInst.destroy();
            
            // Cuando conectes Supabase, aquí deberás sumar los IN y restar los OUT agrupando por item_id.
            // Para visualización inicial, se precargan ejemplos de tu Excel:
            stockChartInst = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['R410a (Kg)', 'R407c (Kg)', 'Motores 500mm', 'Correas A47', 'Correas B38'],
                    datasets: [{
                        label: 'Stock Actual (Unidades / Kg)',
                        data: [70.8, 79.1, 7, 26, 18], 
                        backgroundColor: ['#3b82f6', '#3b82f6', '#22c55e', '#f97316', '#f97316'],
                        borderRadius: 4
                    }]
                },
                options: { 
                    responsive: true,
                    scales: { y: { beginAtZero: true } }
                }
            });
            
            // KPIs Simulados iniciales
            document.getElementById('kpi-refrigerante').innerText = '149.9';
            document.getElementById('kpi-motores').innerText = '9';
            document.getElementById('kpi-correas').innerText = '44';
        }

        // --- 5. INICIALIZACIÓN ---
        document.addEventListener('DOMContentLoaded', () => {
            loadItems();
            loadDashboard();
        });

        // --- 6. ENVÍO DE FORMULARIOS A SUPABASE ---
        document.getElementById('form-movimiento').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!supabaseClient) return alert('Por favor configura las credenciales de Supabase en el código.');
            
            const movimiento = {
                item_id: document.getElementById('mov-item').value,
                tipo: document.getElementById('mov-tipo').value,
                cantidad: parseFloat(document.getElementById('mov-cantidad').value),
                fecha: document.getElementById('mov-fecha').value,
                tag: document.getElementById('mov-tag').value,
                sala: document.getElementById('mov-sala').value,
                cto: document.getElementById('mov-cto').value,
                observaciones: document.getElementById('mov-obs').value
            };

            const { error } = await supabaseClient.from('inventario_movimientos').insert([movimiento]);
            if(error) {
                alert('Error al registrar: ' + error.message);
            } else {
                alert('Movimiento registrado con éxito en la base de datos.');
                document.getElementById('form-movimiento').reset();
                document.getElementById('mov-fecha').valueAsDate = new Date();
            }
        });

        document.getElementById('form-catalogo').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!supabaseClient) return alert('Por favor configura las credenciales de Supabase en el código.');

            const nuevoItem = {
                categoria: document.getElementById('cat-categoria').value,
                descripcion: document.getElementById('cat-desc').value,
                stock_actual: 0
            };

            const { error } = await supabaseClient.from('inventario_items').insert([nuevoItem]);
            if(error) {
                alert('Error al guardar: ' + error.message);
            } else {
                alert('Nuevo ítem agregado al catálogo.');
                document.getElementById('form-catalogo').reset();
                loadItems(); // Recargar el dropdown de movimientos
            }
        });
    </script>
</body>
</html>
